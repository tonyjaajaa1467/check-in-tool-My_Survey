# My_Survey 后端配置文件
# 复制此文件为 .env 并填入您的实际值
#
# 使用方法:
#   1. cp .env.example .env
#   2. 编辑 .env 填入真实值
#   3. ./start.sh start
#
# 注意: .env 文件不应提交到版本控制

# ============ 必需配置 ============

# 下载 CSV 文件的密码 (必需)
DOWNLOAD_PASSWORD="your_download_password"

# 选项设置的管理密码 (可选，默认同 DOWNLOAD_PASSWORD)
OPTIONS_PASSWORD="your_options_password"

# ============ WebDAV 配置 (可选) ============
# 如果不需要 WebDAV 同步，可留空

# WebDAV 服务器地址
WEBDAV_URL="https://xxx.com"

# WebDAV 用户名
WEBDAV_USER="webdav_user"

# WebDAV 密码
WEBDAV_PASS="webdav_password"

# SSL 验证: false=跳过验证(仅自签名), true=强制验证(推荐生产)
WEBDAV_VERIFY="false"

# ============ Flask 配置 (可选) ============

# 调试模式: 1=开启(开发), 0=关闭(生产)
FLASK_DEBUG="0"

# 后端监听端口 (默认: 5001)
PORT="5001"

# SSL 证书路径 (默认: 当前目录下的 cert.pem 和 key.pem)
SSL_CERT_PATH="ssl/cert.pem"
SSL_KEY_PATH="ssl/key.pem"
